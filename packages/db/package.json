{
  "name": "@so-yummy/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./normalize": "./src/normalize.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@so-yummy/contracts": "workspace:*",
    "@neondatabase/serverless": "latest",
    "drizzle-orm": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "vitest": "latest"
  }
}
